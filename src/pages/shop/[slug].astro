---
import {readFile} from 'node:fs/promises';
import '../../modules/DouyinShop/BrandChrome.css';
import prototype from '../../modules/DouyinShop/prototype.html?raw';
import s from '../../modules/DouyinShop/ShopPage.module.css';
import {shopMarkup} from '../../modules/DouyinShop/engine.js';
export async function getStaticPaths(){
 const data=JSON.parse(await readFile('content/published/home.json','utf8'));
 return data.content.filter((c:any)=>c.type==='DouyinGallery').flatMap((c:any)=>c.props.items.map((item:any)=>({params:{slug:item.slug}})));
}
const data=JSON.parse(await readFile('content/published/home.json','utf8'));
const item=data.content.filter((c:any)=>c.type==='DouyinGallery').flatMap((c:any)=>c.props.items).find((i:any)=>i.slug===(Astro.params as {slug:string}).slug);
if(!item)return Astro.redirect('/404');
const head=prototype.match(/<head>([\s\S]*?)<\/head>/)![1];
const body=prototype.match(/<body>([\s\S]*?)<\/body>/)![1];
const [before,after]=body.split('<!--V2_BRAND_CONTENT-->');
---
<!doctype html><html lang="zh-CN"><head><Fragment set:html={head}/></head><body><Fragment set:html={before}/><main class={s.page} data-shop-page style={`width:100%;min-height:0;--component-radius:${item.page.componentRadius}px`}><div class={s.content} set:html={shopMarkup(item.page)}/></main><script id="v2-shop-data" type="application/json" set:html={JSON.stringify(item.page).replace(/</g,"\\u003c")}/><Fragment set:html={after}/></body></html>
<style is:global>
/* Only the brand slot uses V2 spacing; all prototype chrome remains original. */
#panel-brand.panel {padding:0;}
</style>
<script>
import {attachShop} from '../../modules/DouyinShop/engine.js';
import {preparePageLoading} from '../../modules/DouyinShop/loading.js';
const root=document.querySelector<HTMLElement>('[data-shop-page]')!;
preparePageLoading(root);
// Engine state comes from its rendered data attributes; no second header runtime.
attachShop(root, JSON.parse(document.querySelector("#v2-shop-data")!.textContent!), true);
</script>
