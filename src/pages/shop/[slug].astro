---
import {readFile} from 'node:fs/promises';
import '../../styles/global.css';
import {ShopPage} from '../../modules/DouyinShop/ShopPage';
export async function getStaticPaths(){
 const data=JSON.parse(await readFile('content/published/home.json','utf8'));
 return data.content.filter((c:any)=>c.type==='DouyinGallery').flatMap((c:any)=>c.props.items.map((item:any)=>({params:{slug:item.slug}})));
}
const data=JSON.parse(await readFile('content/published/home.json','utf8'));
const item=data.content.filter((c:any)=>c.type==='DouyinGallery').flatMap((c:any)=>c.props.items).find((i:any)=>i.slug===(Astro.params as {slug:string}).slug);
if(!item) return Astro.redirect('/404');
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{item.name} · 抖音店铺</title></head><body style="background:#f5f5f7"><ShopPage page={item.page} client:load/></body></html>
